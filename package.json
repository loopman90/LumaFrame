{
  "name": "lumaframe",
  "version": "0.1.0",
  "description": "Turn photos, GIFs and videos into a customizable ambient gallery and digital photo frame inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "gallery",
    "slideshow",
    "photo-frame"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
